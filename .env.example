# Copy to .env (git-ignored) and fill in – or leave the keys out of this file and export them from your own
# secret manager: the process environment wins over .env. consult never reads a project's own .env.

# A key for the provider(s) you use – the model name picks the provider (see README, "Providers"):
#   gpt-… / o…    → OpenAI       claude-…  → Anthropic       vendor/model (openai/gpt-6-sol) → OpenRouter
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Force one provider regardless of the model name (openai, anthropic, openrouter); normally leave empty
CONSULT_PROVIDER=

# Everyday model for every project (required); a project's config [model] name or --model overrides it.
# e.g. gpt-6-sol, claude-sonnet-5-5, anthropic/claude-opus-5-5
CONSULT_MODEL=gpt-6-sol
# The best model you can get – used at --effort high/xhigh or with --best (not for every consultant)
# e.g. gpt-6-astra, claude-opus-5-5
CONSULT_MODEL_BEST=gpt-6-astra
# Asked instead when the model's provider has no key, rejects it, or has no credit left (once per call, never
# for other errors). e.g. CONSULT_MODEL=claude-sonnet-5-5 with CONSULT_FALLBACK_MODEL=gpt-6-sol
CONSULT_FALLBACK_MODEL=
# The same for CONSULT_MODEL_BEST; empty → CONSULT_FALLBACK_MODEL
CONSULT_FALLBACK_MODEL_BEST=
# Reasoning effort: low, medium, high, xhigh (default medium)
CONSULT_EFFORT=medium
# Web search for the consultants: off unless on here or --web per call. What the model finds goes into its context;
# treat it as material, not instructions.
CONSULT_WEB=off
# Stop a panel/review when its estimated spend passes this many USD (per run; --max-usd overrides)
CONSULT_MAX_USD=5
# How long a silent stream may stay silent before the call fails (seconds)
CONSULT_STALL_SECONDS=180
# OpenAI only: responses (default: web_search tool available) or chat (old chat-completions endpoint, no tools)
OPENAI_API=responses
